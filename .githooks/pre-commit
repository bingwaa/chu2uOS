#!/bin/sh
# 提交前依据 assets/imgs 的实际文件重建 assets/imgs.json，避免新增图片漏登记。
command -v node >/dev/null 2>&1 || {
  echo "pre-commit: 未找到 node，跳过 imgs.json 重建" >&2
  exit 0
}
[ -f tools/gen-imgs-json.mjs ] || exit 0
node tools/gen-imgs-json.mjs || {
  echo "pre-commit: imgs.json 重建失败，已中止提交" >&2
  exit 1
}
git add assets/imgs.json
